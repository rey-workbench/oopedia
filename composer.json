{
    "name": "oopedia/laravel-inertia-svelte",
    "description": "Laravel 12.x Inertia OOPedia",
    "license": "MIT",
    "homepage": "https://github.com/reyworkbench/oopedia",
    "keywords": [
        "Laravel",
        "Skripsi",
        "Rule Based",
        "Forward Chaining",
        "Adaptive Quiz",
        "Inertia",
        "OOPedia"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/legacy-factories": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.11",
        "inertiajs/inertia-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.4",
        "jcf/boost-for-kiro-ide": "^1.0",
        "laravel/pint": "^1.27",
        "laravel/boost": "^1.8"
    }
}