{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "pnpm": {
            "type": "local",
            "command": [
                "pnpm",
                "dlx",
                "@jixo/mcp-pnpm"
            ],
            "enabled": true
        },
        "svelte": {
            "type": "local",
            "command": [
                "pnpm",
                "dlx",
                "@sveltejs/mcp"
            ],
            "enabled": true
        },
        "typescript": {
            "type": "local",
            "command": [
                "C:/Users/WINDOWS/go/bin/typescript-mcp.exe"
            ],
            "enabled": true
        },
        "github": {
            "type": "local",
            "command": [
                "pnpm",
                "dlx",
                "@ildunari/github-mcp-server",
                "--github-token",
                "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"
            ],
            "enabled": true
        },
        "sequential-thinking": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": true
        }
    }
}