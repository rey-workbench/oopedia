@startuml
title UC-10. Evaluasi Adaptive Engine (Forward Chaining)

|Mahasiswa|
start
:Menyelesaikan soal kuis;
:Mengirimkan jawaban;

|Sistem|
fork
    :Menyimpan riwayat jawaban;
    :Memperbarui metrik performa\n(Akurasi, Kecepatan, dll);
fork again
    :Menerima permintaan evaluasi adaptif;
    :Menerima data status pelajar saat ini;
    :Mengambil definisi fakta primer\ndari basis data;

    repeat
        :Membaca rumus logika pada\nsetiap definisi fakta;
        :Membandingkan nilai metrik pelajar\ndengan syarat fakta (operator & threshold);
        if (Kondisi fakta terpenuhi?) then (Ya)
            :Menambahkan ke daftar fakta aktif;
        else (Tidak)
        endif
    repeat while (Masih ada definisi fakta?) is (Ya)

    :Mengambil seluruh aturan adaptif\nyang aktif (diurutkan prioritas);

    partition "Loop Forward Chaining\n(Maks 10 Iterasi)" {
        repeat
            :Memeriksa setiap aturan:\napakah fakta syarat terpenuhi\ndi daftar fakta aktif?;
            if (Aturan terpenuhi & belum pernah terpicu?) then (Ya)
                :Menandai aturan terpicu;
                if (Aturan menghasilkan fakta baru?) then (Ya)
                    :Menginjeksikan fakta baru\nke daftar fakta aktif;
                else (Tidak)
                endif
            else (Tidak)
            endif
        repeat while (Ada fakta baru ditambahkan?) is (Ya)
    }
end fork

if (Ada aturan yang terpicu?) then (Ya)
    :Mengembalikan hasil:\ndaftar aturan terpicu, aksi,\ndan fakta aktif;
else (Tidak)
    :Mencari aturan cadangan (fallback)\ndi basis data;
    if (Aturan cadangan ditemukan?) then (Ya)
        :Mengembalikan hasil\ndari aturan cadangan;
    else (Tidak)
        :Mengembalikan hasil default\ntanpa aksi;
    endif
endif

stop
@enduml


@startuml
title UC-11. Update Student State (Gamifikasi: XP, Badge, dsb)

|Mahasiswa|
start
:Menyelesaikan soal / tantangan;

|Sistem|
:Menerima permintaan pembaruan\nstatus pelajar dari layanan kuis;
:Mengambil tingkat kesulitan\nsoal yang dijawab;
:Menentukan poin dasar\nberdasarkan tingkat kesulitan;
:Menghitung jumlah percobaan\nmenjawab soal tersebut;
:Menerapkan faktor pengurang poin\nberdasarkan jumlah percobaan;
:Menghitung poin akhir:\npoin dasar × faktor pengurang;
fork
    :Menambahkan poin akhir\nke total XP mahasiswa;
    :Memeriksa syarat pencapaian\nlevel baru;
fork again
    if (Apakah jawaban benar?) then (Ya)
        :Menambahkan rekor jawaban\nberturut-turut (streak);
    else (Tidak)
        :Mengembalikan rekor streak\nke angka nol;
    endif
    :Memperbarui nilai streak maksimum;
    :Memeriksa syarat pemberian badge;
end fork
:Menyimpan seluruh perubahan\nke tabel student states;

stop
@enduml


