@startuml
title UC-01. Melihat Materi Pembelajaran

|Mahasiswa|
start
:Mengakses halaman daftar materi;

|Sistem|
:Mengidentifikasi pengguna & status akses;
if (Apakah pengguna sudah login?) then (Ya)
    :Mengambil seluruh daftar materi\nbeserta status progress per materi;
else (Tidak / Guest)
    :Mengambil daftar materi\ndengan akses terbatas;
endif
:Menampilkan halaman daftar materi;

|Mahasiswa|
:Memilih salah satu materi;

|Sistem|
fork
    :Mengambil detail materi:\nkonten teks dan daftar sub-materi;
fork again
    if (Apakah pengguna login?) then (Ya)
        :Menyinkronisasi konteks materi\ndengan status adaptif mahasiswa;
        :Mencatat log akses materi;
    else (Tidak)
    endif
end fork
:Menampilkan halaman detail materi;

|Mahasiswa|
:Membaca konten materi;

stop
@enduml


@startuml
title UC-02. Mengerjakan Kuis

|Mahasiswa|
start
:Memilih materi & tingkat kesulitan kuis;

|Sistem|
:Mengidentifikasi pengguna & status guest;
if (Apakah pengguna login?) then (Ya)
    :Menyinkronisasi konteks materi\ndengan status adaptif;
    :Menentukan tingkat kesulitan target\ndari status adaptif;
else (Tidak / Guest)
    :Menggunakan tingkat kesulitan\ndefault / manual;
endif
:Mengambil data kuis:\nsoal aktif, progress, total soal;
if (Apakah masih ada soal tersisa?) then (Tidak)
    :Mengarahkan ke halaman review hasil kuis;
    stop
else (Ya)
endif

|Sistem|
:Menampilkan soal saat ini;

|Mahasiswa|
:Mengisi jawaban soal;
:Mengirim jawaban;

|Sistem|
:Memvalidasi format jawaban;
fork
    :Memproses jawaban pada layanan kuis;
    :Menerima hasil status benar/salah;
fork again
    if (Apakah pengguna guest?) then (Ya)
        :Mengambil status sesi sementara;
    else (Tidak)
        :Mengambil rekam performa mahasiswa\ndari basis data;
    endif
    :Menyinkronisasi status adaptif terbaru;
end fork
:Menentukan langkah selanjutnya\nberdasar status adaptif;
:Mengekstrak rantai aturan\nyang terpicu dari hasil evaluasi;
:Memformat penjelasan aturan\nuntuk ditampilkan;
:Mengirim respon balik:\nstatus, pesan, perolehan poin, rekomendasi;

|Mahasiswa|
:Melihat feedback hasil jawaban;
:Melanjutkan ke soal berikutnya;

stop
@enduml


