:Menampilkan daftar sertifikat\nbeserta tier: Gold, Silver, Bronze;

|Mahasiswa|
if (Memilih aksi?) then (Preview)
    |Sistem|
    :Mengambil data mahasiswa,\nmateri, dan tier sertifikat;
    :Memuat logo, tanda tangan,\ndan membuat kode QR verifikasi;
    :Menentukan palet warna\nsesuai tier (Gold/Silver/Bronze);
    :Menampilkan halaman preview sertifikat;
elseif (Download) then
    |Sistem|
    :Memverifikasi apakah mahasiswa\nmemiliki sertifikat untuk materi ini;
    if (Sertifikat dimiliki?) then (Ya)
        fork
            :Meng-generate dokumen PDF\nsertifikat secara otomatis;
        fork again
            :Mencatat log akses unduhan;
            :Memverifikasi kode QR keamanan;
        end fork
        :Memberikan file PDF untuk diunduh;
        |Mahasiswa|
        :Mengunduh file sertifikat;
    else (Tidak)
        :Menolak akses:\nsertifikat belum diperoleh;
    endif
else (Kembali)
endif

